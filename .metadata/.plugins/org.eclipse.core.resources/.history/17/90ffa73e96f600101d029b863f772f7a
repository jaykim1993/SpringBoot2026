<!DOCTYPE html>
<html lang="ko" xmlns:th="http://www.thymeleaf.org">
<head>
<meta charset="UTF-8">
<title>도서 대여 정보</title>
</head>
<body>
	<h2>도서 대여 정보</h2>
	<ul>
		<li th:each="도서명 : ${titles}" th:text="${title}"></li>
		<li th:each="저자 : ${authors}" th:text="${author}"></li>
		<li th:each="ISBN : ${isbns}" th:text="${isbn}"></li>
		<li th:each="대여자 : ${users}" th:text="${user}"></li>
	</ul>
</body>
</html>