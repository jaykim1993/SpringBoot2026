<!DOCTYPE html>
<html lang="ko" xmlns:th="http://www.thymeleaf.org">
<head>
<meta charset="UTF-8">
<title>주문 입력</title>
</head>
<body>
	<form th:action="@{/product/orderResult}" method="POST">
		<label id = "itemName">상품 입력</label>
		<input type="text" name="itemName" placeholder="상품명 입력"/>
		<br>
		<label id = "itemPrice">상품금액 입력</label>
		<input type="text" name="itemPrice" placeholder="상품금액 입력"/>
		<br>
		<label id = "itemQty">수량 입력</label>
		<input type="text" name="itemQty" placeholder="수량 입력"/>
		<br>
		<label id = "ordererName">주문자 입력</label>
		<input type="text" name="ordererName" placeholder="주문자 입력"/>
		<br>
		<input type="submit" name="submit" value="주문하기"/>
	</form>
</body>
</html>