<!DOCTYPE html>
<html lang="ko" xmlns:th="http://www.thymeleaf.org">
<head>
<meta charset="UTF-8">
<title>주문 입력</title>
</head>
<body>
	<form th:action="@{/book/rentalProc}" method="POST">
