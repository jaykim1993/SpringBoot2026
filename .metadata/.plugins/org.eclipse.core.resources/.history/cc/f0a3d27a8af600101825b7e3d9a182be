//			@RequestParam(value = "id") String id,
//			@RequestParam(value = "pw") String pw,
//			Model model
//			) {
//		model.addAttribute("login_id", pw);
//		model.addAttribute("login_pw", pw);
//		return "SignInResult";
//	}
	
	// 로그인하기 메서드 - Model 말고 ModelAndView 메서드 사용하기
	@PostMapping("/member/signin_confirm")
	public ModelAndView SignInConfirm(
			@RequestParam(value = "id") String id,
			@RequestParam(value = "pw") String pw
//			Model model
			) {
		ModelAndView modelView = new ModelAndView();
		modelView.addObject("id", id);
		modelView.addObject("pw", pw);
		modelView.setViewName("SignInResult");
		return modelView;
	}
	


}
